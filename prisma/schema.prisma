generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
}

model Customer {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  email     String @unique
  phone     String

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  category    String
  unit        String
  price       Float
  image       String?
  badge       String?
  stock       Int     @default(0)
  isActive    Boolean @default(true)
  featured    Boolean @default(false)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([featured])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(COD)

  subtotal    Float
  deliveryFee Float
  total       Float

  deliveryAddress String
  deliveryArea    String
  deliveryCity    String
  deliveryNotes   String?
  deliveryTime    String

  items    OrderItem[]
  delivery Delivery?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name     String
  price    Float
  quantity Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Delivery {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status DeliveryStatus @default(PENDING)

  riderName  String?
  riderPhone String?

  estimatedDelivery DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
