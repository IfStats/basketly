generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([email])
  @@index([phone])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  category    String
  unit        String
  price       Float
  image       String?
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  badge       String?
  orderItems  OrderItem[]

  @@index([category])
  @@index([isActive])
  @@index([featured])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(COD)
  subtotal        Float
  deliveryFee     Float
  total           Float
  deliveryAddress String
  deliveryArea    String
  deliveryCity    String
  deliveryNotes   String?
  deliveryTime    String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  discount        Float         @default(0)
  promotionCode   String?
  delivery        Delivery?
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Delivery {
  id                String         @id @default(cuid())
  orderId           String         @unique
  status            DeliveryStatus @default(PENDING)
  riderName         String?
  riderPhone        String?
  estimatedDelivery DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Promotion {
  id              String        @id @default(cuid())
  name            String
  code            String        @unique
  type            PromotionType
  value           Float         @default(0)
  minimumOrder    Float?
  maximumDiscount Float?
  startsAt        DateTime
  endsAt          DateTime?
  usageLimit      Int?
  usageCount      Int           @default(0)
  targetSegment   String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([active])
  @@index([code])
  @@index([startsAt])
  @@index([endsAt])
  @@index([targetSegment])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}
